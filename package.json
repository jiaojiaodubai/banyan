{
  "name": "banyan",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@10.24.0",
  "description": "Fully customize citation styles using JavaScript in Zotero",
  "config": {
    "addonName": "Banyan",
    "addonID": "banyan@jiaojiaodubai",
    "addonRef": "banyan",
    "addonInstance": "Banyan",
    "prefsPrefix": "extensions.zotero.banyan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaojiaodubai/banyan.git"
  },
  "author": "jiaojiaodubai",
  "bugs": {
    "url": "https://github.com/jiaojiaodubai/banyan/issues"
  },
  "homepage": "https://github.com/jiaojiaodubai/banyan#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "pnpm gen:style-lint && pnpm gen:style-editor-dts && pnpm gen:wps-addin-manifest && pnpm gen:presets-manifest && zotero-plugin serve",
    "build": "pnpm gen:style-lint && pnpm gen:style-editor-dts && pnpm gen:wps-addin-manifest && pnpm gen:presets-manifest && zotero-plugin build && tsc --noEmit && pnpm typecheck:tests",
    "gen:i10n": "node scripts/genFluentTypings.mjs",
    "gen:style-lint": "node scripts/genStyleLint.mjs",
    "check:style-lint": "node scripts/genStyleLint.mjs --check",
    "gen:style-editor-dts": "node scripts/genStyleEditorDTS.mjs",
    "gen:wps-addin-manifest": "node scripts/genWPSAddinManifest.mjs",
    "gen:presets-manifest": "node scripts/genPresetsManifest.mjs",
    "lint:check": "pnpm check:style-lint && pnpm lint:main && pnpm lint:style-editor && pnpm typecheck:tests",
    "lint:fix": "pnpm lint:fix:main && pnpm lint:fix:style-editor",
    "lint:main": "prettier --check . && eslint .",
    "lint:fix:main": "prettier --write . && eslint . --fix",
    "lint:style-editor": "eslint --config addon/content/styleEditor/eslint.config.mjs addon/content/styleEditor",
    "lint:fix:style-editor": "eslint --config addon/content/styleEditor/eslint.config.mjs addon/content/styleEditor --fix",
    "typecheck:tests": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p tests-node/tsconfig.json",
    "release": "zotero-plugin release",
    "release:prepare": "pnpm update && pnpm submodules:update && pnpm integrations:build && pnpm build && pnpm changelog",
    "changelog": "changelogen --output CHANGELOG.md",
    "integrations:build": "node scripts/build-integrations.mjs",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "pnpm submodules:init && git submodule update --remote --recursive",
    "test": "node scripts/runTestWithLog.mjs",
    "test:node": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 10000 \"tests-node/**/*.test.ts\"",
    "test:scaffold": "zotero-plugin test",
    "update-deps": "pnpm update"
  },
  "dependencies": {
    "@banyan/core": "https://github.com/jiaojiaodubai/banyan-toolchain/releases/download/v0.1.0/banyan-core-0.1.0.tgz?rev=3a0c8db",
    "@banyan/style-contract": "https://github.com/jiaojiaodubai/banyan-toolchain/releases/download/v0.1.0/banyan-style-contract-0.1.0.tgz?rev=3a0c8db",
    "zotero-plugin-toolkit": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-banyan-style": "https://github.com/jiaojiaodubai/banyan-toolchain/releases/download/v0.1.0/eslint-plugin-banyan-style-0.1.0.tgz?rev=3a0c8db",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      },
      {
        "files": [
          "addon/content/styleEditor/snippets.jsonc"
        ],
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  }
}
